<script>
        // Simple script to handle category active state on scroll
        document.addEventListener('DOMContentLoaded', () => {
            const sections = document.querySelectorAll('section');
            const navLinks = document.querySelectorAll('nav.sticky a');

            const observerOptions = {
                root: null,
                rootMargin: '-100px 0px -60% 0px',
                threshold: 0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        navLinks.forEach(link => {
                            if (link.getAttribute('href') === `#${id}`) {
                                link.classList.remove('text-on-surface-variant');
                                link.classList.add('text-primary', 'border-b-2', 'border-primary');
                            } else {
                                link.classList.add('text-on-surface-variant');
                                link.classList.remove('text-primary', 'border-b-2', 'border-primary');
                            }
                        });
                    }
                });
            }, observerOptions);

            sections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
