              <select id="fCat">
                <option>Çorbalar</option><option>Ana Yemekler</option><option>Pilav & Bakliyat</option>
                <option>Kebaplar</option><option>Tatlılar & Meyve</option><option>İçecekler</option>
              </select>
            </div>
          </div>
          <label>Açıklama</label><input id="fDesc" placeholder="örn. Tereyağlı, limonlu">
          <button class="btn" type="submit">Ekle</button>
