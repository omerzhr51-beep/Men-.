  td input{padding:5px 8px;margin:0}
  .msg{padding:10px 14px;border-radius:8px;margin-bottom:12px;font-size:14px}
  .ok{background:#1d3a1d;color:#7dd87d;border:1px solid #3a6b3a}
  .err{background:#3a1d1d;color:#e08a8a;border:1px solid #6b3a3a}
  .hidden{display:none!important}
  .tabs{display:flex;gap:6px;margin-bottom:18px;flex-wrap:wrap}
  .tabs button{background:var(--card2);color:var(--muted);border:1px solid #4a4238;padding:8px 14px;border-radius:8px;cursor:pointer;font-size:13px}
  .tabs button.on{background:var(--accent);color:#1a150f;font-weight:700;border-color:var(--accent)}
  .logout{float:right;font-size:12px;color:var(--muted);cursor:pointer;text-decoration:underline}
  .lock-link{position:fixed;bottom:16px;right:16px;background:var(--card2);border:1px solid #4a4238;color:var(--muted);width:44px;height:44px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}
</style>
</head>
<body>

<header>
  <div class="header-in">
    <div class="logo">🍽️ Lezzet Durağı</div>
    <div id="statusBadge" class="badge open">—</div>
  </div>
  <nav>
    <a href="#anasayfa" data-nav="anasayfa">Menü</a>
    <a href="#ekip" data-nav="ekip">Ekibimiz</a>
    <a href="#iletisim" data-nav="iletisim">İletişim</a>
