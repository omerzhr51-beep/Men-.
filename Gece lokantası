        <form id="hoursForm">
          <div class="row">
            <div><label>Açılış Saati</label><input id="hOpen" type="time" required></div>
            <div><label>Kapanış Saati</label><input id="hClose" type="time" required></div>
          </div>
          <button class="btn" type="submit">Kaydet</button>
        </form>
      </div>

      <div id="tab-sifre" class="hidden">
        <form id="passForm">
          <label>Mevcut Şifre</label><input id="pOld" type="password" required>
          <label>Yeni Şifre</label><input id="pNew" type="password" minlength="4" required>
          <button class="btn" type="submit">Şifreyi Değiştir</button>
        </form>
      </div>
    </div>
  </section>
</main>

<footer>© 2026 Lezzet Durağı — Tüm hakları saklıdır</footer>
<a class="lock-link" href="#panel" title="Yönetim Paneli">🔐</a>

<script>
const LS_ITEMS='ld_items_v1', LS_SET='ld_set_v1';
const DEFAULT_ITEMS=[
  {name:"Mercimek Çorbası",cat:"Çorbalar",price:60,desc:"Tereyağlı, limonlu",on:true},
  {name:"Ezogelin Çorbası",cat:"Çorbalar",price:65,desc:"Naneli, kırmızı biberli",on:true},
  {name:"Tavuk Suyu Çorbası",cat:"Çorbalar",price:70,desc:"Şehriyeli, terbiyeli",on:true},
  {name:"İskender",cat:"Kebaplar",price:220,desc:"Tereyağı, domates sosu, yoğurtlu",on:true},
  {name:"Adana Kebap",cat:"Kebaplar",price:240,desc:"Acılı, közlenmiş biberli",on:true},
  {name:"Tas Kebabı",cat:"Ana Yemekler",price:200,desc:"Düdüklüde pişmiş kuzu eti",on:true},
  {name:"Zeytinyağlı Yaprak Sarma",cat:"Ana Yemekler",price:140,desc:"Limonlu, zeytinyağlı",on:true},
  {name:"Güveç",cat:"Ana Yemekler",price:190,desc:"Taş fırında, sebzeli",on:true},
  {name:"Pilav",cat:"Pilav & Bakliyat",price:60,desc:"Tane tane, tereyağlı",on:true},
  {name:"Nohut",cat:"Pilav & Bakliyat",price:90,desc:"Etli nohut yemeği",on:true},
  {name:"Kuru Fasulye",cat:"Pilav & Bakliyat",price:100,desc:"Pastırmalı, et suyuyla",on:true},
  {name:"Meyve Tabağı",cat:"Tatlılar & Meyve",price:120,desc:"Mevsim meyveleriyle",on:true},
  {name:"Sütlaç",cat:"Tatlılar & Meyve",price:70,desc:"Fırın sütlaç",on:true},
  {name:"Baklava",cat:"Tatlılar & Meyve",price:90,desc:"Cevizli, 4 dilim",on:true},
  {name:"Ayran",cat:"İçecekler",price:25,desc:"Yayık ayran, 1 lt",on:true},
  {name:"Çay",cat:"İçecekler",price:15,desc:"Demli, ince belli bardak",on:true},
];
const TEAM=[
  {n:"Ahmet Yılmaz",r:"Şef / Usta",i:"A"},
  {n:"Mehmet Demir",r:"Aşçıbaşı",i:"M"},
  {n:"Ayşe Kaya",r:"Garson",i:"A"},
  {n:"Fatma Şahin",r:"Kasiyer",i:"F"},
];
function load(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}}
function save(k,v){localStorage.setItem(k,JSON.stringify(v))}
let items=load(LS_ITEMS,DEFAULT_ITEMS);
let set=load(LS_SET,{pass:"1234",open:"09:00",close:"22:00"});
let authed=sessionStorage.getItem('ld_auth')==='1';

const CATS=["Çorbalar","Ana Yemekler","Pilav & Bakliyat","Kebaplar","Tatlılar & Meyve","İçecekler"];
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function fmt(p){return Number(p).toLocaleString('tr-TR',{minimumFractionDigits:Number(p)%1?2:0})+' ₺'}
function isOpenNow(){
  const n=new Date(),c=n.getHours()*60+n.getMinutes();
  const[oh,om]=set.open.split(':').map(Number),[ch,cm]=set.close.split(':').map(Number);
  return c>=oh*60+om && c<ch*60+cm;
}
function renderStatus(){
  const b=document.getElementById('statusBadge');
  const open=isOpenNow();
  b.textContent=open?'● Şu An Açık':'● Şu An Kapalı';
  b.className='badge '+(open?'open':'closed');
  document.getElementById('hoursText').textContent=set.open+' - '+set.close;
}
function renderMenu(){
  const area=document.getElementById('menuArea');let h='';
  CATS.forEach(cat=>{
    const its=items.filter(i=>i.cat===cat);
    if(!its.length)return;
    h+='<div class="cat-title">'+esc(cat)+'</div><div class="grid">';
    its.forEach(i=>{
      h+='<div class="item'+(i.on?'':' off')+'"><h3>'+esc(i.name)+(i.on?'':'<span class="tag">Tükendi</span>')+'<span class="price">'+fmt(i.price)+'</span></h3><p>'+esc(i.desc||'')+'</p></div>';
    });
    h+='</div>';
  });
  area.innerHTML=h;
}
function renderTeam(){
  document.getElementById('teamArea').innerHTML=TEAM.map(t=>
    '<div class="member"><div class="avatar">'+t.i+'</div><h4>'+t.n+'</h4><span>'+t.r+'</span></div>').join('');
}
function renderAdmin(){
  const tb=document.getElementById('adminTable');
  tb.innerHTML=items.map((i,x)=>
    '<tr><td><b>'+esc(i.name)+'</b></td><td>'+esc(i.cat)+'</td>'
    +'<td style="width:110px"><input type="number" step="0.5" value="'+i.price+'" onchange="updPrice('+x+',this.value)"></td>'
    +'<td><button class="btn sec" style="padding:4px 10px;font-size:12px" onclick="toggleOn('+x+')">'+(i.on?'✓ Var':'✗ Tükendi')+'</button></td>'
    +'<td><button class="btn dng" onclick="delItem('+x+')">Sil</button></td></tr>').join('');
}
function msg(id,txt,ok){document.getElementById(id).innerHTML='<div class="msg '+(ok?'ok':'err')+'">'+txt+'</div>';setTimeout(()=>{const e=document.getElementById(id);if(e)e.innerHTML=''},2500)}

function route(){
  let h=(location.hash||'#anasayfa').slice(1);
  const views=['anasayfa','ekip','iletisim','login','panel'];
  if(h==='panel')h=authed?'panel':'login';
  if(!views.includes(h))h='anasayfa';
  views.forEach(v=>document.getElementById('v-'+v).classList.toggle('hidden',v!==h));
  document.querySelectorAll('[data-nav]').forEach(a=>a.classList.toggle('act',a.dataset.nav===h));
  window.scrollTo(0,0);
}
function showTab(t,btn){
  ['yemekler','ekle','saatler','sifre'].forEach(x=>document.getElementById('tab-'+x).classList.toggle('hidden',x!==t));
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('on'));
  if(btn)btn.classList.add('on');
  if(t==='saatler'){document.getElementById('hOpen').value=set.open;document.getElementById('hClose').value=set.close}
}

document.getElementById('loginForm').addEventListener('submit',e=>{
  e.preventDefault();
  if(document.getElementById('passInput').value===set.pass){
    authed=true;sessionStorage.setItem('ld_auth','1');
    document.getElementById('passInput').value='';
    renderAdmin();location.hash='#panel';route();
  }else msg('loginMsg','Hatalı şifre!',false);
});
function logout(){authed=false;sessionStorage.removeItem('ld_auth');location.hash='#anasayfa';route()}

document.getElementById('addForm').addEventListener('submit',e=>{
  e.preventDefault();
  items.push({name:document.getElementById('fName').value.trim(),cat:document.getElementById('fCat').value,
    price:parseFloat(document.getElementById('fPrice').value)||0,
    desc:document.getElementById('fDesc').value.trim(),on:true});
  save(LS_ITEMS,items);e.target.reset();
  renderMenu();renderAdmin();msg('tabMsg','Yemek eklendi ✓',true);
});
function updPrice(x,v){items[x].price=parseFloat(v)||0;save(LS_ITEMS,items);renderMenu();msg('tabMsg','Fiyat güncellendi ✓',true)}
function toggleOn(x){items[x].on=!items[x].on;save(LS_ITEMS,items);renderMenu();renderAdmin()}
function delItem(x){if(confirm('"'+items[x].name+'" silinsin mi?')){items.splice(x,1);save(LS_ITEMS,items);renderMenu();renderAdmin()}}
document.getElementById('hoursForm').addEventListener('submit',e=>{
  e.preventDefault();set.open=document.getElementById('hOpen').value;set.close=document.getElementById('hClose').value;
  save(LS_SET,set);renderStatus();msg('tabMsg','Çalışma saatleri kaydedildi ✓',true);
});
document.getElementById('passForm').addEventListener('submit',e=>{
  e.preventDefault();
  if(document.getElementById('pOld').value!==set.pass)return msg('tabMsg','Mevcut şifre hatalı!',false);
  set.pass=document.getElementById('pNew').value;save(LS_SET,set);e.target.reset();
  msg('tabMsg','Şifre değiştirildi ✓',true);
});

window.addEventListener('hashchange',route);
renderMenu();renderTeam();renderStatus();route();
</script>
</body>
</html>"""
import os
os.makedirs('/mnt/agents/output', exist_ok=True)
with open('/mnt/agents/output/restoran-menu.html','w',encoding='utf-8') as f:
    f.write(html)
print("OK, bytes:", len(html.encode('utf-8')))
