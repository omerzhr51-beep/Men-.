  </section>

  <!-- ILETISIM -->
  <section id="v-iletisim" class="hidden">
    <div class="hero"><h1>İletişim</h1></div>
    <div class="panel-wrap" style="margin-top:0">
      <p>📍 Atatürk Cad. No:42, Merkez</p><br>
      <p>📞 0 (312) 000 00 00</p><br>
      <p>✉️ info@lezzetduragi.com</p>
    </div>
  </section>

  <!-- PANEL - LOGIN -->
  <section id="v-login" class="hidden">
    <div class="panel-wrap">
      <h2>🔐 Yönetim Paneli Girişi</h2>
      <div id="loginMsg"></div>
      <form id="loginForm">
        <label>Şifre</label>
        <input type="password" id="passInput" placeholder="Panel şifrenizi girin" required>
        <button class="btn" type="submit" style="width:100%">Giriş Yap</button>
      </form>
