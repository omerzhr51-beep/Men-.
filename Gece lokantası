</header>

<main>
  <!-- ANASAYFA -->
  <section id="v-anasayfa">
    <div class="hero">
      <h1>Lezzet Durağı</h1>
      <p>Geleneksel Türk mutfağı, ev yapımı lezzetler</p>
      <div class="hours-box">🕒 Çalışma Saatleri: <b id="hoursText">—</b></div>
    </div>
    <div id="menuArea"></div>
  </section>

  <!-- EKIP -->
  <section id="v-ekip" class="hidden">
    <div class="hero"><h1>Ekibimiz</h1><p>Lezzetlerimizin arkasındaki insanlar</p></div>
