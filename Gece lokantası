      <div class="tabs">
        <button class="on" onclick="showTab('yemekler',this)">Yemekler</button>
        <button onclick="showTab('ekle',this)">Yemek Ekle</button>
        <button onclick="showTab('saatler',this)">Açık Saatler</button>
